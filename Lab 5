import json
with open("config.json", "r") as f:
    config = json.load(f)
print("Config values:")
print(config)
results = {
    "accuracy": 0.91,
    "loss": 0.35,
    "epochs": config["epochs"],
    "learning_rate": config["learning_rate"]
}
with open("results.json", "w") as f:
    json.dump(results, f, indent=4)
print("Results saved to results.json")
